# =========================================================================
# CropDeal Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =========================================================================

# Meta / Facebook Developer App Credentials
# Obtain from https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=1390479643108998
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cropdeal_auth_db?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=mohan
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
JWT_SECRET=CropDealAuthServiceSecretKeyForJwtTokenGeneration2026Secure
JWT_EXPIRATION=86400000

# Service Discovery & Config
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Microservice URLs
AUTH_SERVICE_URI=http://localhost:8081
USER_SERVICE_URI=http://localhost:8082
API_GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200
